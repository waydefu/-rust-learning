{
  "name": "rust-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "cargo run --quiet --locked --manifest-path tools/site-render/Cargo.toml -- build",
    "dev": "cargo run --quiet --locked --manifest-path tools/site-render/Cargo.toml -- dev",
    "check": "cargo run --quiet --locked --manifest-path tools/site-render/Cargo.toml -- check",
    "check:rust": "cargo run --quiet --locked --manifest-path tools/site-render/Cargo.toml -- check-rust",
    "test:browser": "playwright test",
    "test:regression": "node scripts/regression/check-native.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.62.0"
  }
}
